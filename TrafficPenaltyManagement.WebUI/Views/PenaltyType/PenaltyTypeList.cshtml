@model List<TrafficPenaltyManagement.Application.Dtos.PenaltyDtos.PenaltyTypeDto>

@{
    ViewData["Title"] = "Ceza Türleri";
}

<h2>Ceza Türleri</h2>

<a asp-action="CreatePenaltyType" class="btn btn-primary mb-3">
    Yeni Ceza Türü Ekle
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ceza Tipi Adı</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                <td>
                    <a asp-action="UpdatePenaltyType"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Düzenle
                    </a>

                    <form asp-action="DeletePenaltyType"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">

                        <button type="submit" class="btn btn-danger btn-sm">
                            Sil
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>