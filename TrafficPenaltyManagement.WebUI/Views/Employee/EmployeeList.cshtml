@model List<TrafficPenaltyManagement.Application.Dtos.EmployeeDtos.EmployeeDto>

<style>
    html,
    body {
        width: 100%;
        min-height: 100%;
        margin: 0 !important;
        padding: 0 !important;
    }

    body {
        background: #f5f7fb !important;
    }

    main {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

        main > .container,
        main > .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

    .employee-page {
        width: 100%;
        min-height: calc(100vh - 56px);
        background: #f5f7fb;
        padding: 35px 45px 50px;
        box-sizing: border-box;
    }

    .employee-content {
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .page-header {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 6px;
    }

    .page-subtitle {
        color: #6b7280;
        margin: 0;
    }

    .create-btn {
        background: #2563eb;
        color: white;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s;
    }

        .create-btn:hover {
            background: #1d4ed8;
            color: white;
            transform: translateY(-1px);
        }

    .filter-card {
        width: 100%;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, .03);
        box-sizing: border-box;
    }

    .filter-form {
        display: flex;
        align-items: flex-end;
        gap: 15px;
        width: 100%;
    }

    .filter-group {
        flex: 1;
    }

    .filter-label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .filter-input {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        outline: none;
        font-size: 14px;
        box-sizing: border-box;
    }

        .filter-input:focus {
            border-color: #2563eb;
        }

    .filter-btn {
        height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 8px;
        background: #2563eb;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

        .filter-btn:hover {
            background: #1d4ed8;
        }

    .clear-btn {
        height: 42px;
        padding: 0 18px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: white;
        color: #374151;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .clear-btn:hover {
            background: #f9fafb;
            color: #111827;
        }

    .employee-card {
        width: 100%;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-sizing: border-box;
        box-shadow: 0 3px 15px rgba(0, 0, 0, .03);
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f9fafb;
    }

    th {
        padding: 16px 20px;
        text-align: left;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    td {
        padding: 18px 20px;
        color: #374151;
        font-size: 14px;
        border-bottom: 1px solid #f1f3f5;
        white-space: nowrap;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    .employee-name {
        font-weight: 600;
        color: #111827;
    }

    .department-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .active-badge {
        display: inline-block;
        background: #ecfdf5;
        color: #059669;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .inactive-badge {
        display: inline-block;
        background: #fef2f2;
        color: #dc2626;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: white;
        color: #374151;
        text-decoration: none;
        transition: .2s;
    }

        .action-btn:hover {
            background: #f9fafb;
            color: #111827;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .employee-page {
            padding: 25px 15px 40px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

        .create-btn {
            width: 100%;
            text-align: center;
        }

        .filter-form {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            width: 100%;
        }

        .filter-btn,
        .clear-btn {
            width: 100%;
        }
    }
</style>

<div class="employee-page">

    <div class="employee-content">

        <div class="page-header">
            <div>
                <h1 class="page-title">
                    Çalışan Yönetimi
                </h1>

                <p class="page-subtitle">
                    Çalışanları görüntüleyebilir ve yönetebilirsiniz.
                </p>
            </div>

            <a asp-controller="Employee"
               asp-action="CreateEmployee"
               class="create-btn">
                + Çalışan Ekle
            </a>
        </div>

        <!-- Filtre Alanı -->
        <div class="filter-card">

            <form asp-controller="Employee"
                  asp-action="EmployeeList"
                  method="get"
                  class="filter-form">

                <div class="filter-group">

                    <label class="filter-label">
                        Departman
                    </label>

                    <input type="text"
                           name="department"
                           class="filter-input"
                           placeholder="Departman giriniz..." />

                </div>

                <div class="filter-group">

                    <label class="filter-label">
                        Şube
                    </label>

                    <input type="text"
                           name="branch"
                           class="filter-input"
                           placeholder="Şube giriniz..." />

                </div>

                <button type="submit"
                        class="filter-btn">
                    Filtrele
                </button>

                <a asp-controller="Employee"
                   asp-action="EmployeeList"
                   class="clear-btn">
                    Temizle
                </a>

            </form>

        </div>

        <!-- Çalışan Listesi -->
        <div class="employee-card">

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Departman</th>
                            <th>Pozisyon</th>
                            <th>Şube</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var employee in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="employee-name">
                                            @employee.FirstName @employee.LastName
                                        </span>
                                    </td>

                                    <td>
                                        @employee.EMail
                                    </td>

                                    <td>
                                        <span class="department-badge">
                                            @employee.Department
                                        </span>
                                    </td>

                                    <td>
                                        @employee.Position
                                    </td>

                                    <td>
                                        @employee.Branch
                                    </td>

                                    <td>

                                        @if (employee.IsActive)
                                        {
                                            <span class="active-badge">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inactive-badge">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <a asp-controller="Employee"
                                               asp-action="EmployeeDetail"
                                               asp-route-id="@employee.Id"
                                               class="action-btn"
                                               title="Çalışan Detayı">
                                                👤
                                            </a>

                                            <a asp-controller="Employee"
                                               asp-action="Edit"
                                               asp-route-id="@employee.Id"
                                               class="action-btn"
                                               title="Çalışanı Güncelle">
                                                ✏️
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    style="text-align: center; padding: 40px;">
                                    Arama kriterlerine uygun çalışan bulunamadı.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

