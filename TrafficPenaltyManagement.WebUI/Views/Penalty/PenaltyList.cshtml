@model List<TrafficPenaltyManagement.Application.Dtos.PenaltyDtos.PenaltyDto>

@{
    ViewData["Title"] = "Ceza Listesi";
    var userRole = ViewBag.UserRole;
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-weight: 600;
        }

    .penalty-table {
        vertical-align: middle;
    }

        .penalty-table th {
            font-weight: 600;
            background-color: #f8f9fa;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-new {
        background-color: #fff3cd;
        color: #856404;
    }

        .status-new .status-dot {
            background-color: #ffc107;
        }

    .status-manager {
        background-color: #e7f1ff;
        color: #0d6efd;
    }

        .status-manager .status-dot {
            background-color: #0d6efd;
        }

    .status-finance {
        background-color: #f0e7ff;
        color: #6f42c1;
    }

        .status-finance .status-dot {
            background-color: #6f42c1;
        }

    .status-completed {
        background-color: #d1e7dd;
        color: #146c43;
    }

        .status-completed .status-dot {
            background-color: #198754;
        }

    .status-rejected {
        background-color: #f8d7da;
        color: #b02a37;
    }

        .status-rejected .status-dot {
            background-color: #dc3545;
        }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
    }

        .action-buttons form {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .rejection-input {
        width: 180px;
    }

    .penalty-table th:last-child,
    .penalty-table td:last-child {
        min-width: 430px;
    }
</style>

<div class="page-header">
    <div>
        <h2>Ceza Listesi</h2>
        <p class="text-muted mb-0">
            Trafik cezalarını ve onay süreçlerini yönetin.
        </p>
    </div>

    <a asp-action="CreatePenalty" class="btn btn-primary">
        + Yeni Ceza Oluştur
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Başarılı!</strong>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>İşlem gerçekleştirilemedi!</strong>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover penalty-table mb-0">

                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Durum</th>
                        <th>Ret Nedeni</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-message">
                                    Henüz kayıtlı bir trafik cezası bulunmamaktadır.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var penalty in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @penalty.Plate
                                    </strong>
                                </td>

                                <td>
                                    @switch (penalty.Status)
                                    {
                                        case TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.New:
                                            <span class="status-badge status-new">
                                                <span class="status-dot"></span>
                                                Yeni
                                            </span>
                                            break;

                                        case TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.ManagerApproval:
                                            <span class="status-badge status-manager">
                                                <span class="status-dot"></span>
                                                Yönetici Onayı
                                            </span>
                                            break;

                                        case TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.FinanceApproval:
                                            <span class="status-badge status-finance">
                                                <span class="status-dot"></span>
                                                Finans Onayı
                                            </span>
                                            break;

                                        case TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.Completed:
                                            <span class="status-badge status-completed">
                                                <span class="status-dot"></span>
                                                Tamamlandı
                                            </span>
                                            break;

                                        case TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.Rejected:
                                            <span class="status-badge status-rejected">
                                                <span class="status-dot"></span>
                                                Reddedildi
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(penalty.RejectionReason))
                                    {
                                        <span class="text-danger">
                                            @penalty.RejectionReason
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        @* NEW - SADECE MANAGER *@
                                        @if (penalty.Status == TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.New &&
                                                                        userRole == TrafficPenaltyManagement.Domain.Enums.UserRole.Manager)
                                        {
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Yönetici Onayla
                                                </button>
                                            </form>

                                            <form asp-action="Reject" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <input type="text"
                                                       name="rejectionReason"
                                                       class="form-control form-control-sm rejection-input"
                                                       placeholder="Ret nedeni"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Reddet
                                                </button>
                                            </form>
                                        }

                                        @* MANAGER APPROVAL - SADECE FINANCE *@
                                        @if (penalty.Status == TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.ManagerApproval &&
                                                                        userRole == TrafficPenaltyManagement.Domain.Enums.UserRole.Finance)
                                        {
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Finans Onayla
                                                </button>
                                            </form>

                                            <form asp-action="Reject" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <input type="text"
                                                       name="rejectionReason"
                                                       class="form-control form-control-sm rejection-input"
                                                       placeholder="Ret nedeni"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Reddet
                                                </button>
                                            </form>
                                        }

                                   
                                        @if (penalty.Status == TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.FinanceApproval &&
                                                                        userRole == TrafficPenaltyManagement.Domain.Enums.UserRole.Finance)
                                        {
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Finans Onayla
                                                </button>
                                            </form>

                                            <form asp-action="Reject" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@penalty.Id" />

                                                <input type="text"
                                                       name="rejectionReason"
                                                       class="form-control form-control-sm rejection-input"
                                                       placeholder="Ret nedeni"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Reddet
                                                </button>
                                            </form>
                                        }

                                 
                                        @if (penalty.Status == TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.Completed ||
                                                                        penalty.Status == TrafficPenaltyManagement.Domain.Enums.PenaltyStatus.Rejected)
                                        {
                                            <span class="text-muted small">
                                                İşlem tamamlandı
                                            </span>
                                        }

                                        <a asp-action="History"
                                           asp-route-id="@penalty.Id"
                                           class="btn btn-outline-info btn-sm">
                                            Geçmiş
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>

    </div>
</div>