@model TrafficPenaltyManagement.Application.Dtos.PenaltyDtos.CreatePenaltyDto

@{
    ViewData["Title"] = "Yeni Trafik Cezası";
}

<h2>Yeni Trafik Cezası</h2>

<form asp-action="CreatePenalty"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Plate" class="form-label">Araç Plakası</label>

        <select asp-for="Plate"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.Vehicles, "Plate", "Plate"))">
            <option value="">Plaka Seçiniz</option>
        </select>

        <span asp-validation-for="Plate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label">Çalışan</label>

        <select asp-for="EmployeeId"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.Employees, "Id", "FirstName"))">
            <option value="">Çalışan Seçiniz</option>
        </select>

        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PenaltyTypeId" class="form-label">
            Ceza Tipi
        </label>

        <select asp-for="PenaltyTypeId"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.PenaltyTypes, "Id", "Name"))">

            <option value="">Ceza Tipi Seçiniz</option>

        </select>

        <span asp-validation-for="PenaltyTypeId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Ceza Tutarı (₺)</label>

        <input asp-for="Amount"
               class="form-control"
               type="number"
               step="0.01"
               placeholder="Örn: 1500" />


        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PenaltyDate">Ceza Tarihi</label>
        <input asp-for="PenaltyDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="PenaltyDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Document" class="form-label">Ceza Belgesi</label>

        <input asp-for="Document"
               class="form-control"
               type="file"
               accept=".pdf" />

        <span asp-validation-for="Document"
              class="text-danger">
        </span>
    </div>

    <button type="submit" class="btn btn-primary">
        Ceza Oluştur
    </button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}