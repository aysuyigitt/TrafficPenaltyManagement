@model TrafficPenaltyManagement.Application.Dtos.PenaltyDtos.CreatePenaltyDto

@{
    ViewData["Title"] = "Yeni Trafik Cezası";
}

<h2>Yeni Trafik Cezası</h2>

<form asp-action="CreatePenalty" method="post">

    <div class="mb-3">
        <label asp-for="Plate" class="form-label">
            Araç Plakası
        </label>

        <input asp-for="Plate"
               class="form-control"
               placeholder="Örn: 41 ABC 123" />

        <span asp-validation-for="Plate"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Ceza Oluştur
    </button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}